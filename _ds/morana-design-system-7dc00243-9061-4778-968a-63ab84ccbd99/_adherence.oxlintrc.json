{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:company|individual|sage|neutral|deferred)$/]",
        "message": "<Badge> tone must be one of 'company' | 'individual' | 'sage' | 'neutral' | 'deferred'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|onClick|disabled|type|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, onClick, disabled, type, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:lang|email|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<ContactForm> doesn't accept that prop. Declared props: lang, email, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactForm'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|bg)$/]",
        "message": "<ContactForm> lang must be one of 'en' | 'bg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:lang|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: lang, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|bg)$/]",
        "message": "<Footer> lang must be one of 'en' | 'bg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|type|value|onChange|placeholder|required|hint|error|lang|requiredLabel|multiline|rows|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, id, type, value, onChange, placeholder, required, hint, error, lang, requiredLabel, multiline, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|url)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'tel' | 'url'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|bg)$/]",
        "message": "<Input> lang must be one of 'en' | 'bg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LanguageToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|inverse|style|key|ref|className|style|children)$/]",
        "message": "<LanguageToggle> doesn't accept that prop. Declared props: value, onChange, inverse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LanguageToggle'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:en|bg)$/]",
        "message": "<LanguageToggle> value must be one of 'en' | 'bg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:lang|onLangChange|active|onNavigate|inverse|floating|style|key|ref|className|style|children)$/]",
        "message": "<NavHeader> doesn't accept that prop. Declared props: lang, onLangChange, active, onNavigate, inverse, floating, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavHeader'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|bg)$/]",
        "message": "<NavHeader> lang must be one of 'en' | 'bg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgramCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:track|name|duration|description|cta|href|deferred|style|key|ref|className|style|children)$/]",
        "message": "<ProgramCard> doesn't accept that prop. Declared props: track, name, duration, description, cta, href, deferred, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgramCard'] > JSXAttribute[name.name='track'] > Literal[value!=/^(?:company|individual)$/]",
        "message": "<ProgramCard> track must be one of 'company' | 'individual'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResearchCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:finding|citation|source|note|inverse|style|key|ref|className|style|children)$/]",
        "message": "<ResearchCallout> doesn't accept that prop. Declared props: finding, citation, source, note, inverse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RingMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|rings|completed|animated|weight|nodes|inverse|style|key|ref|className|style|children)$/]",
        "message": "<RingMark> doesn't accept that prop. Declared props: size, rings, completed, animated, weight, nodes, inverse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|accent|lead|mark|align|level|inverse|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, accent, lead, mark, align, level, inverse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
